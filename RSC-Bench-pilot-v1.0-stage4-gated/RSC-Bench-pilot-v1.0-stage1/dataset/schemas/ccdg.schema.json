{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-Component Dependency Graph",
  "type": "object",
  "required": [
    "case_id",
    "base_input_sha256",
    "nodes",
    "edges"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "base_input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "relation"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "calls",
              "depends_on",
              "reads",
              "writes",
              "authenticated_by",
              "protected_by",
              "produces_error"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
