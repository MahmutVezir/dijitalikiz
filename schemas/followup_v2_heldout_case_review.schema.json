{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Follow-up v2 Held-out Case Review Audit",
  "type": "object",
  "required": ["protocol_version", "status", "frozen", "packet_manifest_sha256", "reviewers", "adjudicator", "case_decisions"],
  "properties": {
    "protocol_version": {"const": "followup-v2-heldout-case-review-1.0"},
    "status": {"enum": ["draft", "adjudicated"]},
    "frozen": {"type": "boolean"},
    "packet_manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["reviewer_id", "independent_review_attestation", "source_revision_review_attestation", "reviewed_packet_sha256", "response_sha256"],
        "properties": {
          "reviewer_id": {"type": "string", "minLength": 1},
          "independent_review_attestation": {"const": true},
          "source_revision_review_attestation": {"const": true},
          "reviewed_packet_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "response_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "adjudicator": {
      "type": "object",
      "required": ["reviewer_id", "source_evidence_reviewed", "completed_at_utc"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "source_evidence_reviewed": {"const": true},
        "completed_at_utc": {"type": "string", "minLength": 10}
      },
      "additionalProperties": false
    },
    "case_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "pre_fix_revision", "fixed_revision", "review_a_decision", "review_b_decision", "final_decision", "root_cause_adjudicated", "dependency_edges_adjudicated", "single_coherent_defect", "disagreement_resolved", "ccdg_suitability", "license_reviewed", "contamination_risk", "rationale", "evidence_urls"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "pre_fix_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
          "fixed_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
          "review_a_decision": {"enum": ["keep", "revise", "exclude"]},
          "review_b_decision": {"enum": ["keep", "revise", "exclude"]},
          "final_decision": {"enum": ["keep_for_followup_confirmatory", "revise", "exclude"]},
          "root_cause_adjudicated": {"type": "boolean"},
          "dependency_edges_adjudicated": {"type": "boolean"},
          "single_coherent_defect": {"type": "boolean"},
          "disagreement_resolved": {"type": "boolean"},
          "ccdg_suitability": {"enum": ["strong", "moderate", "weak", "ineligible"]},
          "license_reviewed": {"type": "boolean"},
          "contamination_risk": {"enum": ["low", "medium", "high", "unresolved"]},
          "rationale": {"type": "string", "minLength": 30},
          "evidence_urls": {"type": "array", "minItems": 2, "items": {"type": "string", "format": "uri"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
