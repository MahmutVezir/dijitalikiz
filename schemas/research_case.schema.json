{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchCase",
  "type": "object",
  "required": [
    "case_id",
    "source",
    "source_url",
    "publication_date",
    "technology",
    "error_description",
    "i_base",
    "ccdg",
    "ground_truth"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "publication_date": {
      "type": "string",
      "minLength": 1
    },
    "technology": {
      "type": "string",
      "minLength": 1
    },
    "error_description": {
      "type": "string",
      "minLength": 1
    },
    "i_base": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "ccdg": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "relation"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "ground_truth": {
      "type": "object",
      "required": [
        "component",
        "entity",
        "operation",
        "root_cause"
      ],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "root_cause": {
          "type": "string",
          "minLength": 1
        },
        "required_relations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_relation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "split": {
      "type": "string",
      "enum": [
        "pilot",
        "confirmatory",
        "candidates"
      ]
    },
    "software_twin_snapshot": {
      "type": "object",
      "required": [
        "repository_url",
        "snapshot_revision",
        "regression_test",
        "observed_failure_signal"
      ],
      "properties": {
        "repository_url": {"type": "string", "format": "uri"},
        "snapshot_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "regression_test": {"type": "string", "minLength": 3},
        "observed_failure_signal": {"type": "string", "minLength": 15}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
