  "gold_standard": {
    "status": "human_recorded",
    "gold_mechanism_id": "G1_POLYNOMIAL_CONTROL_INPUT_DEFAULT_DISCARDED",
    "candidate_mechanisms": [
      {
        "mechanism_id": "G1_POLYNOMIAL_CONTROL_INPUT_DEFAULT_DISCARDED",
        "description": "The supplied polynomial-control val is forwarded and stored, but ControlInterpComp initializes the corresponding input to ones rather than the stored val.",
        "testable_prediction": "On the buggy base, a fresh polynomial-control phase created with val=[5.0, 15.0] exposes [[1.0], [1.0]] at the promoted controls input; the fixed revision exposes [[5.0], [15.0]]."
      },
      {
        "mechanism_id": "A1_POLYNOMIAL_VALUE_SHAPE_NORMALIZATION",
        "description": "A shape/broadcast normalization defect prevents the supplied default from being represented correctly.",
        "testable_prediction": "Changing only the valid shape of the supplied values while holding the component input-construction path constant would change or eliminate the mismatch if shape normalization were causal."
      },
      {
        "mechanism_id": "A2_STALE_TEST_SETUP_VALUE_OVERRIDE",
        "description": "A reused test fixture or post-setup set_val override replaces the caller's default before the observation.",
        "testable_prediction": "A fresh independently constructed phase with no post-setup set_val operation would no longer reproduce the mismatch if a stale fixture override were causal."
      },
      {
        "mechanism_id": "A3_ODE_TARGET_UNITS_OR_STATE_CONFIGURATION",
        "description": "Downstream ODE targets, units, or state/parameter configuration create an apparent value mismatch even when the control input default is correct.",
        "testable_prediction": "Reading the promoted controls input directly before interpreting downstream ODE outputs would show the requested default if this downstream configuration explanation were causal."
      }
    ],
    "technical_rationale": "The pinned base source shows the caller value being forwarded and stored and the options mapping reaching ControlInterpComp, but the active polynomial-control branch adds the input with np.ones(input_shape). The independent public-API reproduction reads the promoted controls input and obtains all ones rather than the requested values. The pinned fixed PR head uses the supplied default. The conclusion is deliberately limited to this input-initialization mechanism and the tested pinned path.",
