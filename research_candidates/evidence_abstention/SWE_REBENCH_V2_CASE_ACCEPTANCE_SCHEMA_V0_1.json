{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SWE-rebench V2 confirmatory case acceptance record",
  "description": "Full case-record shape plus structural conditions. Passing the schema/validator does not independently verify referenced artifacts, licenses, reviewer identity, technical outcomes, or semantic judgments.",
  "type": "object",
  "required": [
    "case_id",
    "acceptance_state",
    "dataset",
    "source",
    "independence",
    "exposure",
    "license_review",
    "technical_reproduction",
    "gold_standard",
    "evidence_tiers"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^SRV2-[A-Z0-9_-]{1,48}$"
    },
    "acceptance_state": {
      "const": "accepted_confirmatory"
    },
    "dataset": {
      "type": "object",
      "required": [
        "dataset_id",
        "file_revision",
        "file_sha256",
        "cohort_role",
        "row_locator",
        "row_sha256"
      ],
      "properties": {
        "dataset_id": {
          "const": "PrimeIntellect/SWE-rebench-V2-Filtered-Verified"
        },
        "file_revision": {
          "const": "fb9aa226b2ce37c708ea7732e7b980abacdadb67"
        },
        "file_sha256": {
          "const": "7416e352008b35480c82610cf4f5edf160dd269ed6bf382a22bd4c17daed24b9"
        },
        "cohort_role": {
          "enum": [
            "primary",
            "project_reserve"
          ]
        },
        "row_locator": {
          "type": "object",
          "required": [
            "field",
            "value"
          ],
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "row_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "repository_full_name",
        "issue_or_pr_url",
        "pull_request_number",
        "base_commit_sha",
        "fixed_commit_sha",
        "changed_paths",
        "patch",
        "base_source_snapshot",
        "fixed_source_snapshot"
      ],
      "properties": {
        "repository_full_name": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "issue_or_pr_url": {
          "type": "string",
          "format": "uri"
        },
        "pull_request_number": {
          "type": "integer",
          "minimum": 1
        },
        "base_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "fixed_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "changed_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "patch": {
          "type": "object",
          "required": [
            "artifact_uri",
            "sha256"
          ],
          "properties": {
            "artifact_uri": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "base_source_snapshot": {
          "type": "object",
          "required": [
            "artifact_uri",
            "sha256"
          ],
          "properties": {
            "artifact_uri": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "fixed_source_snapshot": {
          "type": "object",
          "required": [
            "artifact_uri",
            "sha256"
          ],
          "properties": {
            "artifact_uri": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "independence": {
      "type": "object",
      "required": [
        "review_status",
        "is_independent",
        "upstream_project_id",
        "defect_cluster_id",
        "same_or_related_case_ids",
        "review_record"
      ],
      "properties": {
        "review_status": {
          "const": "passed"
        },
        "is_independent": {
          "const": true
        },
        "upstream_project_id": {
          "type": "string",
          "minLength": 1
        },
        "defect_cluster_id": {
          "type": "string",
          "minLength": 1
        },
        "same_or_related_case_ids": {
          "type": "array",
          "maxItems": 0
        },
        "review_record": {
          "type": "object",
          "required": [
            "artifact_uri",
            "sha256"
          ],
          "properties": {
            "artifact_uri": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "exposure": {
      "type": "object",
      "required": [
        "review_status",
        "confirmatory_analyst_id",
        "confirmatory_analyst_saw_gold_or_fix",
        "prior_pipeline_debug_exposure_status",
        "packet_preparer_id",
        "source_exposed_person_ids",
        "review_record"
      ],
      "properties": {
        "review_status": {
          "const": "passed"
        },
        "confirmatory_analyst_id": {
          "type": "string",
          "minLength": 1
        },
        "confirmatory_analyst_saw_gold_or_fix": {
          "const": false
        },
        "packet_preparer_id": {
          "type": "string",
          "minLength": 1
        },
        "review_record": {
          "type": "object",
          "required": [
            "artifact_uri",
            "sha256"
          ],
          "properties": {
            "artifact_uri": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "prior_pipeline_debug_exposure_status": {
          "const": "none"
        },
        "source_exposed_person_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "license_review": {
      "type": "object",
      "required": [
        "source_license_expression",
        "exact_base_license_review",
        "changed_file_license_review",
        "third_party_content_review",
        "research_use_decision",
        "reviewer_id",
        "review_record"
      ],
      "properties": {
        "source_license_expression": {
          "type": "string",
          "minLength": 1
        },
        "exact_base_license_review": {
          "const": "passed"
        },
        "changed_file_license_review": {
          "const": "passed"
        },
        "third_party_content_review": {
          "const": "passed"
        },
        "research_use_decision": {
          "const": "approved"
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "review_record": {
          "type": "object",
          "required": [
            "artifact_uri",
            "sha256"
          ],
          "properties": {
            "artifact_uri": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "technical_reproduction": {
      "type": "object",
      "required": [
        "status",
        "environment_lock_sha256",
        "reviewer_id",
        "buggy_baseline",
        "fixed_revision",
        "review_record"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "environment_lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "buggy_baseline": {
          "type": "object",
          "required": [
            "commit_sha",
            "exit_code",
            "test_selector",
            "failure_is_targeted_regression",
            "failure_signature",
            "run_record"
          ],
          "properties": {
            "commit_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "exit_code": {
              "type": "integer"
            },
            "test_selector": {
              "type": "string",
              "minLength": 1
            },
            "failure_is_targeted_regression": {
              "const": true
            },
            "failure_signature": {
              "type": "string",
              "minLength": 1
            },
            "run_record": {
              "type": "object",
              "required": [
                "artifact_uri",
                "sha256"
              ],
              "properties": {
                "artifact_uri": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "fixed_revision": {
          "type": "object",
          "required": [
            "commit_sha",
            "exit_code",
            "test_selector",
            "same_test_passed",
            "run_record"
          ],
          "properties": {
            "commit_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "exit_code": {
              "const": 0
            },
            "test_selector": {
              "type": "string",
              "minLength": 1
            },
            "same_test_passed": {
              "const": true
            },
            "run_record": {
              "type": "object",
              "required": [
                "artifact_uri",
                "sha256"
              ],
              "properties": {
                "artifact_uri": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "review_record": {
          "type": "object",
          "required": [
            "artifact_uri",
            "sha256"
          ],
          "properties": {
            "artifact_uri": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "gold_standard": {
      "type": "object",
      "required": [
        "status",
        "agreement_status",
        "final_gold_mechanism_id",
        "candidate_mechanisms",
        "panel_a_reviews"
      ],
      "properties": {
        "status": {
          "const": "approved"
        },
        "agreement_status": {
          "enum": [
            "unanimous",
            "adjudicated"
          ]
        },
        "final_gold_mechanism_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_mechanisms": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "mechanism_id",
              "description"
            ],
            "properties": {
              "mechanism_id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "panel_a_reviews": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "reviewer_id",
              "decision",
              "review_record",
              "gold_mechanism_id"
            ],
            "properties": {
              "reviewer_id": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "const": "approved"
              },
              "review_record": {
                "type": "object",
                "required": [
                  "artifact_uri",
                  "sha256"
                ],
                "properties": {
                  "artifact_uri": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false
              },
              "gold_mechanism_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "adjudication": {
          "type": "object",
          "required": [
            "reviewer_id",
            "final_gold_mechanism_id",
            "review_record"
          ],
          "properties": {
            "reviewer_id": {
              "type": "string",
              "minLength": 1
            },
            "final_gold_mechanism_id": {
              "type": "string",
              "minLength": 1
            },
            "review_record": {
              "type": "object",
              "required": [
                "artifact_uri",
                "sha256"
              ],
              "properties": {
                "artifact_uri": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evidence_tiers": {
      "type": "object",
      "required": [
        "status",
        "panel_b_blind_to_gold",
        "panel_b_blind_to_fix",
        "tier_labels_hidden_until_rating_lock",
        "rating_lock_before_gold_unblinding",
        "panel_b_reviews",
        "final_tier_decisions",
        "packet_set",
        "panel_b_consensus_record"
      ],
      "properties": {
        "status": {
          "const": "approved"
        },
        "panel_b_blind_to_gold": {
          "const": true
        },
        "panel_b_blind_to_fix": {
          "const": true
        },
        "tier_labels_hidden_until_rating_lock": {
          "const": true
        },
        "rating_lock_before_gold_unblinding": {
          "const": true
        },
        "panel_b_reviews": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "reviewer_id",
              "decision",
              "review_record"
            ],
            "properties": {
              "reviewer_id": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "const": "approved"
              },
              "review_record": {
                "type": "object",
                "required": [
                  "artifact_uri",
                  "sha256"
                ],
                "properties": {
                  "artifact_uri": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "final_tier_decisions": {
          "type": "object",
          "required": [
            "E1",
            "E2",
            "E3"
          ],
          "properties": {
            "E1": {
              "type": "object",
              "required": [
                "surviving_mechanism_ids",
                "locked_rating_record"
              ],
              "properties": {
                "surviving_mechanism_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "locked_rating_record": {
                  "type": "object",
                  "required": [
                    "artifact_uri",
                    "sha256"
                  ],
                  "properties": {
                    "artifact_uri": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "E2": {
              "type": "object",
              "required": [
                "surviving_mechanism_ids",
                "locked_rating_record"
              ],
              "properties": {
                "surviving_mechanism_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "locked_rating_record": {
                  "type": "object",
                  "required": [
                    "artifact_uri",
                    "sha256"
                  ],
                  "properties": {
                    "artifact_uri": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "E3": {
              "type": "object",
              "required": [
                "surviving_mechanism_ids",
                "locked_rating_record"
              ],
              "properties": {
                "surviving_mechanism_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "locked_rating_record": {
                  "type": "object",
                  "required": [
                    "artifact_uri",
                    "sha256"
                  ],
                  "properties": {
                    "artifact_uri": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "packet_set": {
          "type": "object",
          "required": [
            "artifact_uri",
            "sha256"
          ],
          "properties": {
            "artifact_uri": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "panel_b_consensus_record": {
          "type": "object",
          "required": [
            "artifact_uri",
            "sha256"
          ],
          "properties": {
            "artifact_uri": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
