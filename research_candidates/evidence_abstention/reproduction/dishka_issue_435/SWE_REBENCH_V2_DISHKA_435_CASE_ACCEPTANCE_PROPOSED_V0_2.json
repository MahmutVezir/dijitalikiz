  "gold_standard": {
    "status": "human_recorded",
    "gold_mechanism_id": "G1_STALE_PER_SCOPE_FACTORY_REGISTRATION",
    "candidate_mechanisms": [
      {
        "mechanism_id": "G1_STALE_PER_SCOPE_FACTORY_REGISTRATION",
        "description": "During provider processing, the buggy builder inserts a factory into its declared scope registry. A later cross-scope override updates the final processed-factory mapping but leaves the earlier per-scope entry stale. Request-scope lookup therefore returns 1 and shadows the later APP-scoped override 42.",
        "testable_prediction": "A fresh container with REQUEST int=1 followed by APP int=42 will resolve 1 on the buggy base; after deferring registry construction until all providers are processed, the same lookup resolves 42."
      },
      {
        "mechanism_id": "A1_SCOPE_CHAIN_PRECEDENCE",
        "description": "The observed value is caused by ordinary current-scope-before-parent lookup semantics rather than a stale registry entry.",
        "testable_prediction": "Without a stale local registration, parent fallback would return the APP-scoped value 42; a locally registered current-scope factory would ordinarily shadow the parent."
      },
      {
        "mechanism_id": "A2_CONSUMER_BINDING_OR_CACHE",
        "description": "The consumer factory or container cache captured an earlier value independently of registry population.",
        "testable_prediction": "If consumer binding/cache is causal, the wrong value should remain explainable without a stale request-scope factory entry, potentially differing between direct get(int) resolution and resolving the Interactor."
      }
    ],
    "technical_rationale": "The pinned base reproducer and all eight frozen dataset selectors fail on the buggy base and pass on the fixed revision. The buggy builder writes to the scope registry during provider processing, before later overrides are complete; the fixed builder defers registry population and builds from the final processed-factory map. The independent reproducer changes the resolved value from 1 to the expected 42.",
