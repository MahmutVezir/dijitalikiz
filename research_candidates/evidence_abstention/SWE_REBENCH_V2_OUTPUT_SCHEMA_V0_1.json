{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SWE-rebench V2 Evidence-Abstention Response v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "root_cause",
    "evidence_refs",
    "rationale",
    "alternative_hypotheses",
    "missing_evidence"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "diagnose",
        "abstain"
      ],
      "description": "diagnose means the model asserts a specific root-cause diagnosis for scoring even if prose is hedged; abstain means it does not assert a specific cause. Human reviewers separately flag any diagnosis leakage in rationale."
    },
    "root_cause": {
      "type": "string",
      "description": "Required non-empty causal claim when decision is diagnose; empty when decision is abstain. A causal claim asserted elsewhere in an abstention rationale may still be scored as diagnosis leakage."
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_-]{0,63}$"
      },
      "uniqueItems": true,
      "maxItems": 8
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "description": "Reasoning based only on visible evidence; for abstention, do not state a specific cause as established fact."
    },
    "alternative_hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "diagnose"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "root_cause": {
            "minLength": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "abstain"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "root_cause": {
            "const": ""
          }
        }
      }
    }
  ]
}
