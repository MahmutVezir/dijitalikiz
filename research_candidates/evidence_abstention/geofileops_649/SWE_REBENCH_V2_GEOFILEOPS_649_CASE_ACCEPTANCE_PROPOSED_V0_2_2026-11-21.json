  "gold_standard": {
    "status": "human_recorded",
    "gold_mechanism_id": "G1_MISSING_NONE_TO_DESTINATION_STEM_FALLBACK",
    "candidate_mechanisms": [
      {
        "mechanism_id": "G1_MISSING_NONE_TO_DESTINATION_STEM_FALLBACK",
        "description": "When dst_layer is None, the buggy copy/append call paths do not call the existing get_default_layer(dst) helper, so the missing default is delegated to GDAL/source-layer behavior instead of the destination filename stem.",
        "testable_prediction": "At the buggy base, default copy/append operations will not consistently use Path(dst).stem; at the fixed PR head, the same operations will use Path(dst).stem when dst_layer is None."
      },
      {
        "mechanism_id": "A1_COPY_LAYER_ONLY",
        "description": "Only copy_layer fails to apply the default destination-layer name; append_to already applies the correct fallback.",
        "testable_prediction": "A frozen append_to selector with dst_layer omitted should pass on the buggy base if this is the sole cause."
      },
      {
        "mechanism_id": "A2_APPEND_TO_ONLY",
        "description": "Only append_to fails to apply the default destination-layer name; copy_layer already applies the correct fallback.",
        "testable_prediction": "Frozen copy_layer selectors with dst_layer omitted should pass on the buggy base if this is the sole cause."
      },
      {
        "mechanism_id": "A3_GET_DEFAULT_LAYER_HELPER_WRONG",
        "description": "The shared get_default_layer helper computes an incorrect destination stem or mishandles file extensions.",
        "testable_prediction": "Direct inspection/execution of get_default_layer on ordinary and compressed destination paths should reveal a wrong stem if this is causal."
      },
      {
        "mechanism_id": "A4_DRIVER_OR_FORMAT_SPECIFIC_BEHAVIOR",
        "description": "A single GDAL driver or source-format interaction causes the layer-name mismatch rather than a common missing default-argument fallback.",
        "testable_prediction": "The defect should be limited to one driver/input-format combination; cross-format frozen selectors and the separate GeoPackage reproducer should not all show the same contract failure."
      }
    ],
    "technical_rationale": "The exact buggy base has a correct get_default_layer(path) helper returning Path(path).stem but does not apply it in copy_layer, append_to or _append_to_nolock when dst_layer is None. The fixed PR adds the fallback at all three relevant boundaries. Stage 2 independently reproduces the default-layer mismatch, confirms an explicit-layer positive control on base, and finds all 10 frozen selectors base-fail/fixed-pass.",
